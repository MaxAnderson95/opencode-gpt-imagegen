{
  "name": "opencode-gpt-imagegen",
  "version": "0.2.0",
  "description": "OpenCode 2 plugin for GPT Image generation through your ChatGPT subscription, with reference images and safe PNG output.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "prebuild": "rm -rf dist",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external",
    "test": "bun test tests/unit",
    "test:e2e_subscription": "OPENCODE_MODEL=openai/gpt-6-sol bun test tests/e2e/subscription.test.ts",
    "release:patch": "bash scripts/prepare-release.sh patch && git push --follow-tags",
    "release:minor": "bash scripts/prepare-release.sh minor && git push --follow-tags",
    "release:major": "bash scripts/prepare-release.sh major && git push --follow-tags"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-ai",
    "openai",
    "gpt-image-2",
    "gpt-image",
    "image-generation",
    "image-editing",
    "text-to-image",
    "chatgpt",
    "chatgpt-images",
    "chatgpt-oauth",
    "codex",
    "plugin"
  ],
  "author": "Yuji Hatakeyama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxAnderson95/opencode-gpt-imagegen.git"
  },
  "homepage": "https://github.com/MaxAnderson95/opencode-gpt-imagegen#readme",
  "bugs": {
    "url": "https://github.com/MaxAnderson95/opencode-gpt-imagegen/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@tsconfig/node22": "^22.0.2",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.24",
    "eventsource-parser": "^4.0.0",
    "file-type": "^22.0.1"
  }
}
